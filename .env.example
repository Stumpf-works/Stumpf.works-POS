# ==============================================
# Stumpf.works POS - Environment Configuration
# ==============================================

# === Application ===
APP_NAME=Stumpf.works POS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# === Backend API ===
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=stumpfworks_pos
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# === Authentication ===
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Multi-Tenant ===
TENANT_HEADER_NAME=X-Tenant-ID
DEFAULT_TENANT_SCHEMA=public
ENABLE_SUBDOMAIN_ROUTING=false

# === SumUp Integration ===
SUMUP_API_URL=https://api.sumup.com/v0.1
SUMUP_CLIENT_ID=your_sumup_client_id
SUMUP_CLIENT_SECRET=your_sumup_client_secret
SUMUP_WEBHOOK_SECRET=your_webhook_secret

# === Cloud-TSE (Fiskaly) ===
FISKALY_API_URL=https://kassensichv.io/api/v2
FISKALY_API_KEY=your_fiskaly_api_key
FISKALY_API_SECRET=your_fiskaly_api_secret
TSE_ENABLED=true

# === Celery ===
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === File Storage ===
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# === GoBD / DSFinV-K ===
EXPORT_DIR=/app/exports
GOBD_RETENTION_YEARS=10

# === Frontend (Vite) ===
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME=Stumpf.works POS
VITE_ENABLE_OFFLINE=true
